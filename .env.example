VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Cast to TV relay. Local dev can omit this (Vite proxies to 8787).
# Live HTTPS site: set this to the deployed relay, e.g.
# VITE_CAST_WS_URL=wss://memoriya-cast.onrender.com/__memoriya-cast
VITE_CAST_WS_URL=ws://localhost:8787/__memoriya-cast
